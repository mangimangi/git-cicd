{
  "jobs": {
    "test": {
      "name": "Unit Tests",
      "on": ["open"],
      "branches": ["**"],
      "paths": ["git-cicd", "install.sh", "templates/**", "tests/**", "pyproject.toml", "ci/**"],
      "setup": "ci/setup.sh",
      "steps": ["ci/test.sh"],
      "manual": false
    },
    "version-check": {
      "name": "Version Check",
      "on": ["open"],
      "branches": ["main"],
      "steps": [[".vendored/pkg/git-semver/git-semver", "check-bump"]],
      "manual": false
    },
    "release": {
      "name": "Release",
      "on": ["merge"],
      "branches": ["main"],
      "steps": [".vendored/pkg/git-semver/release"]
    },
    "vendor-check": {
      "name": "Check Vendor Files",
      "on": ["open"],
      "branches": ["**"],
      "steps": ["ci/vendor-check.sh"],
      "manual": false
    },
    "update-vendored": {
      "name": "Install Vendored",
      "on": ["cron"],
      "cron": "0 9 * * 1",
      "branches": ["main"],
      "steps": ["ci/update-vendored.sh"],
      "secrets": ["CICD_WRITE_TOKEN", "VENDOR_PAT"],
      "inputs": {
        "vendor": {"description": "Vendor to update (or all)", "default": "all"},
        "version": {"description": "Version to install (default: latest)", "default": "latest"},
        "private": {"description": "Vendor repo is private (only needed when adding a new vendor)", "choices": ["true", "false"], "default": "false"}
      }
    }
  },
  "needs_nothing": [".pearls/**", ".madreperla/**", "*.md", "LICENSE", "docs/**"],
  "repository": "git-cicd"
}
