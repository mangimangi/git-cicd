{
  "fields": {
    "version_file": {
      "type": "string",
      "required": false,
      "description": "Path to file storing the current version string (default: VERSION)"
    },
    "files": {
      "type": "array",
      "required": false,
      "description": "Glob patterns for files whose changes trigger automatic patch bumps on merge"
    },
    "updates": {
      "type": "object",
      "required": false,
      "description": "File path to update action mapping for version bumps"
    },
    "changelog": {
      "type": "object",
      "required": false,
      "description": "Changelog generation config (enabled, file, ignore_prefixes)"
    },
    "install": {
      "type": "object",
      "required": false,
      "description": "Installed workflow behavior (on_merge, automerge)"
    },
    "bump_on": {
      "type": "string",
      "required": false,
      "description": "When the version is bumped: \"merge\" (default; release bumps after the merge) or \"pull_request\" (the pull request bumps, checked by git-semver check-bump; release tags the landed commit and pushes nothing to the branch)"
    },
    "default_branch": {
      "type": "string",
      "required": false,
      "description": "The branch whose commits may be tagged and released, as a branch name such as \"main\" (default: the remote's HEAD, origin/HEAD); every path that creates a version tag refuses a commit not reachable from its tip"
    },
    "push_bump": {
      "type": "boolean",
      "required": false,
      "description": "With bump_on pull_request: check-bump raises a missing version by a patch and pushes it to the pull request branch (default true); false = check only"
    }
  }
}
